{
  "name": "pi-standard-agents",
  "version": "0.1.1",
  "description": "PI integration for @t-works/standardagents-runtime — exposes the Standard Agents runtime as tools, commands and lifecycle hooks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-works/pi-standard-agents.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "keywords": [
    "pi-package",
    "standard-agents",
    "pi-extension"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:manifest": "node scripts/check-manifest.mjs",
    "verify:install": "node scripts/install-from-tarball.mjs",
    "smoke": "./scripts/pi-smoke.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@t-works/standardagents-runtime": "^0.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@standardagents/spec": "^0.45.10",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
