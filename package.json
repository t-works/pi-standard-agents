{
  "name": "pi-standard-agents",
  "version": "0.1.0",
  "description": "PI extension that exposes the Standard Agents runtime as tools, commands and lifecycle hooks.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "keywords": [
    "pi-package",
    "standard-agents",
    "pi-extension"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@t-works/standardagents-runtime": "^0.2.1"
  },
  "devDependencies": {
    "@standardagents/spec": "^0.45.10",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
